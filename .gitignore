# 后端秘密和本地 Python 状态：真实 DATABASE_URL 只能放在 backend/.env。
backend/.env
backend/.venv/
backend/__pycache__/
backend/.pytest_cache/
backend/**/*.py[cod]

# 前端依赖和构建产物；只有 .env.example 可以进入 Git。
frontend/node_modules/
frontend/dist/
frontend/.wrangler/
frontend/.env
frontend/.env.*
!frontend/.env.example

# 编辑器与操作系统生成文件。
.idea/
.vscode/
.DS_Store
Thumbs.db
